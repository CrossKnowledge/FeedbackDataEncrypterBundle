{
  "name": "crossknowledge/feedback-data-encrypter-bundle",
  "description": "Encrypter/decrypter service for Feedback service",
  "type": "symfony-bundle",
  "license": "MIT",
  "keywords": [
    "crypto",
    "encrypt",
    "decrypt",
    "symfony2",
    "crossknowledge"
  ],
  "authors": [
    {
      "name": "Aymeric Poude",
      "email": "aymeric.poude@crossknowledge.com"
    }
  ],
  "autoload": {
    "psr-4": { "CrossKnowledge\\FeedbackDataEncrypterBundle\\": "" }
  },
  "require": {
    "php": ">=7.2.5",
    "phpseclib/mcrypt_compat": "^1.0",
    "ext-json": "*",
    "symfony/framework-bundle": "5.4.*",
    "symfony/flex": "^1.15"
  },
  "require-dev": {
    "phpunit/phpunit": "^8",
    "symfony/phpunit-bridge": "^6"
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    }
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "5.4.*"
    }
  }
}
